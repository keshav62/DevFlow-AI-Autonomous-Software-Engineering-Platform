# ============================================================
# DevFlow AI – Monorepo Environment Configuration Template
# Copy relevant sections to each app's .env file.
# NEVER commit production credentials to source control.
# ============================================================

# --- Frontend (apps/frontend/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# --- Express Backend (apps/backend/.env) ---
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://devflow:devflow_password@localhost:5432/devflow_db?schema=public
REDIS_URL=redis://localhost:6379
INTERNAL_AI_SERVICE_URL=http://localhost:8000
INTERNAL_SERVICE_SECRET=devflow_internal_secret_development_phase1

# --- FastAPI AI Service (apps/ai-service/.env) ---
PORT=8000
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://devflow:devflow_password@localhost:5432/devflow_db
REDIS_URL=redis://localhost:6379
OPENAI_API_KEY=sk-placeholder-phase1
GEMINI_API_KEY=AIza-placeholder-phase1
INTERNAL_SERVICE_SECRET=devflow_internal_secret_development_phase1
